# Copy to .env and fill in values
# NEVER commit .env to git

# Gemini API Key (get from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres (get from neon.tech — free, no CC)
NEON_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
NEON_API_KEY=your_neon_api_key
NEON_PROJECT_ID=your_project_id

# Supabase Storage (get from supabase.com — free, no CC)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ACCESS_KEY=your_access_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_PROJECT_ID=yourproject

# Local Postgres (used by docker-compose)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/demo
